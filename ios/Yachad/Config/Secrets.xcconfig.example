// Copy this file to Secrets.xcconfig (same folder) and fill in the project
// you create for the app — see ios/README.md. Secrets.xcconfig is
// git-ignored; never commit real keys.
//
// The anon/publishable key is meant to be public (it ships inside the app
// bundle) — real access control is enforced server-side by RLS, exactly
// like the website. See ios/backend/migrations/0002_access_control.sql.

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR_ANON_PUBLIC_KEY
