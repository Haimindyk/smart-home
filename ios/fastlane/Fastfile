# App Store Connect API-key auth (no Apple ID/2FA in CI). Signing is automatic
# (Xcode-managed). Same pattern as haimindyk/bruto-neto's ios-app/fastlane.
default_platform(:ios)

platform :ios do
  before_all do |lane|
    next unless [:beta, :build_check, :adhoc].include?(lane)

    # GitHub-hosted runners start with an empty keychain: use a temporary one so Xcode's
    # cloud-managed signing (API key) can create and use the distribution certificate.
    setup_ci if ENV["FASTLANE_SETUP_CI"] == "1"

    # gym's -showBuildSettings probe resolves SPM packages; the 3s default is too tight.
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] ||= "120"

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_FILEPATH"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"]
    )

    # xcodebuild's -allowProvisioningUpdates does not reuse fastlane's api_key,
    # so write the same key to a .p8 and pass it via -authenticationKey* flags.
    # Lane code runs with Dir.pwd == ios/fastlane, so this lands at
    # ios/fastlane/asc_api_key.p8, which ios/.gitignore covers.
    key_path = File.expand_path("asc_api_key.p8", Dir.pwd)
    File.write(key_path, api_key[:key])
    File.chmod(0o600, key_path)
    ENV["ASC_API_KEY_PATH"] = key_path

    # The project is generated (and git-ignored); always regenerate it first.
    sh("cd ../App && xcodegen generate")
    # Public Supabase key only (never a secret/service key) goes into a git-ignored xcconfig.
    File.write(
      File.expand_path("../App/Config/Local.xcconfig", Dir.pwd),
      "SUPABASE_PUBLIC_KEY = #{ENV.fetch('SUPABASE_PUBLIC_KEY')}\n"
    )
  end

  after_all do |lane|
    File.delete(ENV["ASC_API_KEY_PATH"]) if ENV["ASC_API_KEY_PATH"] && File.exist?(ENV["ASC_API_KEY_PATH"])
  end

  error do |lane, exception|
    File.delete(ENV["ASC_API_KEY_PATH"]) if ENV["ASC_API_KEY_PATH"] && File.exist?(ENV["ASC_API_KEY_PATH"])
  end

  private_lane :build_signed_app do |options|
    build_number = ENV["GITHUB_RUN_NUMBER"] || (latest_testflight_build_number + 1)
    build_app(
      project: File.expand_path("../App/SmartHomeWellness.xcodeproj", Dir.pwd),
      scheme: "SmartHomeWellness",
      export_method: options[:export_method] || "app-store",
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath #{ENV['ASC_API_KEY_PATH']} -authenticationKeyID #{ENV['APP_STORE_CONNECT_API_KEY_ID']} -authenticationKeyIssuerID #{ENV['APP_STORE_CONNECT_API_ISSUER_ID']} CODE_SIGN_STYLE=Automatic DEVELOPMENT_TEAM=#{ENV['APPLE_DEVELOPER_TEAM_ID']} CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV["APPLE_DEVELOPER_TEAM_ID"]
      }
    )
  end

  desc "Compile the Release archive without signing or uploading (validates the release toolchain on pull requests). Signing here would mint a new Apple certificate on every PR run and exhaust the account's certificate limit."
  lane :build_check do
    sh("xcodebuild archive -project \"#{File.expand_path('../App/SmartHomeWellness.xcodeproj', Dir.pwd)}\" -scheme SmartHomeWellness -configuration Release -destination 'generic/platform=iOS' -archivePath \"#{File.expand_path('../build/check.xcarchive', Dir.pwd)}\" CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY=\"\"")
  end

  desc "Ad-hoc build for devices registered in the developer account (installed directly, no TestFlight, not uploaded anywhere)"
  lane :adhoc do
    build_signed_app(export_method: "ad-hoc")
  end

  desc "Build, sign, and upload to TestFlight Internal"
  lane :beta do
    build_signed_app
    upload_to_testflight(
      api_key: Actions.lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      skip_waiting_for_build_processing: true,
      # Only standard HTTPS (URLSession) and CryptoKit hashing; no custom encryption.
      uses_non_exempt_encryption: false
    )
  end
end
